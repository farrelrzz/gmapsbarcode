<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Cetak Kode Ulasan (<%= total %>)</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=JetBrains+Mono:wght@500;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
<style>
  :root{
    --paper:#EDEAE1; --ink:#1C2321; --ink-soft:#5B6460; --line:#B7AF9E;
    --stamp-red:#B3392F; --brass:#A6784A;
  }
  *{box-sizing:border-box;}
  body{ margin:0; background:#DAD5C6; font-family:'Inter',sans-serif; color:var(--ink); }

  .toolbar{
    position:sticky; top:0; z-index:10; display:flex; align-items:center; gap:16px;
    padding:14px 22px; background:var(--ink); color:var(--paper);
  }
  .toolbar h1{ font-family:'Space Grotesk',sans-serif; font-size:15px; font-weight:700; margin:0; letter-spacing:0.01em;}
  .toolbar span{ font-size:12.5px; color:#C9C2B4; }
  .toolbar button{
    margin-left:auto; font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:13px;
    background:var(--stamp-red); color:#fff; border:none; padding:9px 18px; border-radius:2px;
    cursor:pointer; letter-spacing:0.02em;
  }
  .toolbar button:hover{ filter:brightness(1.08); }

  .sheet{
    max-width:1200px; margin:26px auto; padding:0 18px 60px;
    display:grid; grid-template-columns:repeat(auto-fill, minmax(210px,1fr)); gap:16px;
  }

  .ticket{
    background:var(--paper); border:1.5px dashed var(--line); border-radius:3px;
    padding:14px 14px 12px; position:relative; break-inside:avoid; page-break-inside:avoid;
    display:flex; flex-direction:column; align-items:center; text-align:center;
  }
  .ticket .eyebrow{
    font-family:'Space Grotesk',sans-serif; font-size:9.5px; font-weight:700;
    letter-spacing:0.14em; text-transform:uppercase; color:var(--brass); margin-bottom:8px;
  }
  .ticket .qr{ width:132px; height:132px; }
  .ticket .qr svg{ width:100%; height:100%; display:block; }
  .ticket .code{
    margin-top:10px; font-family:'JetBrains Mono',monospace; font-weight:700; font-size:12px;
    letter-spacing:0.03em; color:var(--ink);
  }
  .ticket .cta{
    margin-top:4px; font-size:9.5px; color:var(--ink-soft); letter-spacing:0.03em;
  }
  .ticket .status{
    position:absolute; top:10px; right:10px; width:8px; height:8px; border-radius:50%;
    background:var(--line);
  }
  .ticket.active .status{ background:#3F6B4B; }

  @media print{
    .toolbar{ display:none; }
    body{ background:#fff; }
    .sheet{ margin:0; padding:0; grid-template-columns:repeat(3, 1fr); gap:6mm; }
    .ticket{ padding:10mm 6mm 8mm; border-color:#999; }
    @page{ size:A4; margin:10mm; }
  }
</style>
</head>
<body>
  <div class="toolbar">
    <h1>Lembar Cetak Kode Ulasan</h1>
    <span><%= total %> tiket</span>
    <button onclick="window.print()">Cetak / Simpan PDF</button>
  </div>

  <div class="sheet">
    <% tickets.forEach(function(t){ %>
      <div class="ticket <%= t.status === 'active' ? 'active' : '' %>">
        <span class="status"></span>
        <div class="eyebrow">Scan &amp; Ulasan</div>
        <div class="qr"><%- t.qrSvg %></div>
        <div class="code"><%= t.code %></div>
        <div class="cta">Tunjukkan bintang 5 favoritmu</div>
      </div>
    <% }); %>
  </div>
</body>
</html>
